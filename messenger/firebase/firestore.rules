rules_version = '2';

// Правила безопасности CISOFT Messenger.
// Публикация: Firebase Console → Firestore Database → Rules → вставить этот файл → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function chatPath(id) { return /databases/$(database)/documents/chats/$(id); }
    function isMemberOf(id) { return me() in get(chatPath(id)).data.members; }

    // ---------- Профили ----------
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'username', 'usernameLower', 'avatar', 'color', 'createdAt', 'lastSeen'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.username is string && d.username.lower() == d.usernameLower
        && d.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && (d.get('avatar', null) == null || (d.avatar is string && d.avatar.size() <= 60000))
        && (d.get('color', null) == null || (d.color is string && d.color.size() <= 20));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == me() && validUser()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == me();
      allow update: if signedIn() && userId == me() && validUser()
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // usernames/{имя} → { uid }. Занять можно только свободное имя и только до создания профиля.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && !exists(/databases/$(database)/documents/users/$(me()));
      allow delete: if signedIn() && resource.data.uid == me();
      allow update: if false;
    }

    // ---------- Чаты ----------
    function validNewChat(chatId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'members', 'title', 'ownerId', 'createdAt', 'updatedAt', 'lastMessage', 'lastRead', 'typing', 'unread'])
        && d.members is list && me() in d.members
        && d.lastMessage == null && d.lastRead.size() == 0 && d.typing.size() == 0 && d.unread.size() == 0
        && (
          (d.type == 'direct' && d.members.size() == 2 && d.members[0] < d.members[1]
            && chatId == d.members[0] + '_' + d.members[1])
          ||
          (d.type == 'group' && d.ownerId == me() && d.members.size() <= 50
            && d.title is string && d.title.size() > 0 && d.title.size() <= 80)
        );
    }

    function ownKeyOnly(field) {
      return !(field in changed())
        || request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([me()]);
    }

    // Обычная активность участника: последнее сообщение, прочтение, «печатает…», счётчики
    function activity() {
      return changed().hasOnly(['lastMessage', 'updatedAt', 'lastRead', 'typing', 'unread'])
        && ownKeyOnly('lastRead') && ownKeyOnly('typing')
        && (!('lastMessage' in changed()) || request.resource.data.lastMessage.senderId == me());
    }

    // Создатель группы меняет состав и название
    function ownerManage() {
      let d = request.resource.data;
      return resource.data.type == 'group' && resource.data.ownerId == me()
        && changed().hasOnly(['members', 'title', 'updatedAt'])
        && me() in d.members && d.members.size() <= 50
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80;
    }

    // Любой участник может удалить из группы только себя
    function leave() {
      let d = request.resource.data;
      return resource.data.type == 'group'
        && changed().hasOnly(['members', 'ownerId', 'updatedAt'])
        && d.members.size() == resource.data.members.size() - 1
        && d.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
        && (d.ownerId == resource.data.ownerId
            || (resource.data.ownerId == me() && d.ownerId in d.members));
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && validNewChat(chatId);
      allow update: if signedIn() && me() in resource.data.members
        && (activity() || ownerManage() || leave());
      allow delete: if false;

      function validMsg() {
        let d = request.resource.data;
        return d.keys().hasOnly(['senderId', 'type', 'text', 'replyTo', 'mediaId', 'preview', 'width', 'height', 'edited', 'deleted', 'createdAt', 'call'])
          && d.senderId == me()
          && d.type in ['text', 'image', 'call', 'system']
          && d.text is string && d.text.size() <= 4000
          && d.createdAt == request.time
          && d.get('deleted', false) == false
          && (d.get('preview', null) == null || (d.preview is string && d.preview.size() <= 30000))
          && (d.get('replyTo', null) == null || (d.replyTo is map && d.replyTo.get('text', '').size() <= 300));
      }

      match /messages/{msgId} {
        allow read: if signedIn() && isMemberOf(chatId);
        allow create: if signedIn() && isMemberOf(chatId) && validMsg();
        allow update: if signedIn() && isMemberOf(chatId)
          && resource.data.senderId == me()
          && resource.data.get('deleted', false) == false
          && changed().hasOnly(['text', 'edited', 'deleted', 'preview'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow delete: if false;
      }

      match /media/{mediaId} {
        allow read: if signedIn() && isMemberOf(chatId);
        allow create: if signedIn() && isMemberOf(chatId)
          && request.resource.data.keys().hasOnly(['data', 'senderId', 'createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000;
        allow delete: if signedIn() && resource.data.senderId == me();
        allow update: if false;
      }
    }

    // ---------- Звонки (только 1:1) ----------
    match /calls/{callId} {
      function party(d) { return me() == d.callerId || me() == d.calleeId; }
      function callDoc() { return get(/databases/$(database)/documents/calls/$(callId)).data; }

      allow get: if signedIn() && party(resource.data);
      allow list: if signedIn() && (resource.data.calleeId == me() || resource.data.callerId == me());
      allow create: if signedIn()
        && request.resource.data.callerId == me()
        && request.resource.data.calleeId != me()
        && request.resource.data.status == 'ringing'
        && get(chatPath(request.resource.data.chatId)).data.type == 'direct'
        && me() in get(chatPath(request.resource.data.chatId)).data.members
        && request.resource.data.calleeId in get(chatPath(request.resource.data.chatId)).data.members;
      allow update: if signedIn() && party(resource.data)
        && !changed().hasAny(['callerId', 'calleeId', 'chatId', 'createdAt', 'offer']);
      allow delete: if false;

      match /callerCandidates/{cid} {
        allow read: if signedIn() && party(callDoc());
        allow create: if signedIn() && callDoc().callerId == me();
      }
      match /calleeCandidates/{cid} {
        allow read: if signedIn() && party(callDoc());
        allow create: if signedIn() && callDoc().calleeId == me();
      }
    }

    // ---------- Счётчики сайта: stats/{itemId} → { downloads, likes } ----------
    // Читать может кто угодно (без входа). Отсутствующее поле считается нулём.
    // downloads — анонимно, только +1 за раз (setDoc(..., {downloads: increment(1)}, {merge: true})).
    // likes — ТОЛЬКО ±1 вместе с созданием/удалением своего likes/{itemId}_{uid} в одном batch.
    match /stats/{itemId} {
      function cnt(d, f) { return d.get(f, 0); }
      function validStats(d) {
        return d.keys().hasOnly(['downloads', 'likes'])
          && cnt(d, 'downloads') is int && cnt(d, 'likes') is int;
      }
      function likePath() { return /databases/$(database)/documents/likes/$(itemId + '_' + request.auth.uid); }
      function likeAdded() { return signedIn() && !exists(likePath()) && existsAfter(likePath()); }
      function likeRemoved() { return signedIn() && exists(likePath()) && !existsAfter(likePath()); }

      allow read: if true;
      allow create: if itemId.matches('^[a-z0-9-]{1,40}$')
        && validStats(request.resource.data)
        && (
          ((cnt(request.resource.data, 'downloads') == 0 || cnt(request.resource.data, 'downloads') == 1)
            && cnt(request.resource.data, 'likes') == 0)
          || (cnt(request.resource.data, 'downloads') == 0 && cnt(request.resource.data, 'likes') == 1 && likeAdded())
        );
      allow update: if itemId.matches('^[a-z0-9-]{1,40}$')
        && validStats(request.resource.data)
        && changed().hasOnly(['downloads', 'likes'])
        && (
          (cnt(request.resource.data, 'downloads') == cnt(resource.data, 'downloads') + 1
            && cnt(request.resource.data, 'likes') == cnt(resource.data, 'likes'))
          || (cnt(request.resource.data, 'downloads') == cnt(resource.data, 'downloads')
            && cnt(request.resource.data, 'likes') == cnt(resource.data, 'likes') + 1 && likeAdded())
          || (cnt(request.resource.data, 'downloads') == cnt(resource.data, 'downloads')
            && cnt(request.resource.data, 'likes') == cnt(resource.data, 'likes') - 1 && likeRemoved())
        );
      allow delete: if false;
    }

    // ---------- Лайки сайта: likes/{itemId}_{uid} → { uid, itemId, at } ----------
    // Создать/удалить можно только свой лайк и только вместе с ±1 в stats/{itemId}.likes (один batch).
    // Читать — только свои: кто что лайкнул, другим не видно.
    match /likes/{likeId} {
      function statsDoc(id) { return /databases/$(database)/documents/stats/$(id); }
      function likesBefore(id) { return exists(statsDoc(id)) ? get(statsDoc(id)).data.get('likes', 0) : 0; }
      function likesAfter(id) { return getAfter(statsDoc(id)).data.get('likes', 0); }

      allow read: if signedIn() && resource.data.uid == me();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'itemId', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'itemId', 'at'])
        && request.resource.data.uid == me()
        && request.resource.data.itemId is string
        && request.resource.data.itemId.matches('^[a-z0-9-]{1,40}$')
        && likeId == request.resource.data.itemId + '_' + me()
        && request.resource.data.at == request.time
        && existsAfter(statsDoc(request.resource.data.itemId))
        && likesAfter(request.resource.data.itemId) == likesBefore(request.resource.data.itemId) + 1;
      allow delete: if signedIn() && resource.data.uid == me()
        && existsAfter(statsDoc(resource.data.itemId))
        && likesAfter(resource.data.itemId) == likesBefore(resource.data.itemId) - 1;
      allow update: if false;
    }

    // ---------- Игры сайта: gamescores/{игра}/scores/{uid} → { name, username, score, at } ----------
    // Читать может кто угодно. Писать — только свой результат, только с именем из своего профиля
    // и только если он лучше прежнего.
    match /gamescores/{game}/scores/{userId} {
      function prof() { return get(/databases/$(database)/documents/users/$(me())).data; }
      function validScore() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'username', 'score', 'at']) && d.keys().hasAll(['name', 'username', 'score', 'at'])
          && game in ['miner', 'space', 'jump']
          && d.score is int && d.score > 0 && d.score <= 1000000000
          && d.at == request.time
          && d.name == prof().name && d.username == prof().username;
      }
      allow read: if true;
      allow create: if signedIn() && userId == me() && validScore();
      allow update: if signedIn() && userId == me() && validScore() && request.resource.data.score > resource.data.score;
      allow delete: if signedIn() && userId == me();
    }

    // ---------- CISOFT LAN: виртуальные сети ----------
    // lannets/{netId} — { name, ownerId, createdAt, maxMembers, pro, open }
    // lannets/{netId}/secret/pass — { hash } (sha256(netId + ":" + пароль)); не читается никем
    // lannets/{netId}/members/{uid} — запись участника (вступить можно только с верным proof)
    // lannets/{netId}/chat/{msgId} — чат сети
    match /lannets/{netId} {
      function lanNet() { return /databases/$(database)/documents/lannets/$(netId); }
      function lanMember(uid) { return exists(/databases/$(database)/documents/lannets/$(netId)/members/$(uid)); }
      function lanOwner() { return get(lanNet()).data.ownerId == me(); }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && netId.matches('^[a-z0-9]{10}$')
        && request.resource.data.ownerId == me()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt', 'maxMembers', 'pro', 'open'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 && request.resource.data.maxMembers <= 64;
      allow update: if signedIn() && resource.data.ownerId == me()
        && request.resource.data.ownerId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'maxMembers', 'open', 'pro'])
        && request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 && request.resource.data.maxMembers <= 64;
      allow delete: if signedIn() && resource.data.ownerId == me();

      match /secret/{doc} {
        allow read: if false;
        allow create: if signedIn() && doc == 'pass' && get(lanNet()).data.ownerId == me()
          && request.resource.data.keys().hasOnly(['hash']) && request.resource.data.hash is string;
        allow update: if signedIn() && doc == 'pass' && get(lanNet()).data.ownerId == me()
          && request.resource.data.keys().hasOnly(['hash']);
        allow delete: if signedIn() && get(lanNet()).data.ownerId == me();
      }

      match /members/{uid} {
        function validMember() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'username', 'vip', 'pubKey', 'candidates', 'online', 'seen', 'proof'])
            && d.name is string && d.name.size() <= 60
            && d.vip is string && d.vip.matches('^10[.]77[.][0-9]{1,3}[.][0-9]{1,3}$')
            && d.pubKey is string && d.pubKey.size() <= 300
            && d.candidates is list && d.candidates.size() <= 12;
        }
        function proofOk() {
          return get(lanNet()).data.get('open', false) == true
            || request.resource.data.proof == get(/databases/$(database)/documents/lannets/$(netId)/secret/pass).data.hash;
        }
        allow read: if signedIn() && (lanMember(me()) || lanOwner());
        allow create: if signedIn() && uid == me() && validMember() && proofOk();
        allow update: if signedIn() && uid == me() && validMember()
          && request.resource.data.proof == resource.data.proof;
        allow delete: if signedIn() && (uid == me() || lanOwner());
      }

      match /chat/{msgId} {
        allow read: if signedIn() && lanMember(me());
        allow create: if signedIn() && lanMember(me())
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || lanOwner());
        allow update: if false;
      }
    }

    // ---------- Личный кабинет сайта: userdata/{uid} ----------
    // { favorites: {itemId: мс}, downloads: [{itemId, label, at}] (≤ 50), lastAccountVisit: мс }. Только владелец.
    match /userdata/{userId} {
      function validUserdata() {
        let d = request.resource.data;
        return d.keys().hasOnly(['favorites', 'downloads', 'lastAccountVisit', 'purchases'])
          && (!('purchases' in d) || (d.purchases is map && d.purchases.size() <= 20))
          && (!('favorites' in d) || (d.favorites is map && d.favorites.size() <= 200))
          && (!('downloads' in d) || (d.downloads is list && d.downloads.size() <= 50))
          && (!('lastAccountVisit' in d) || d.lastAccountVisit is number);
      }
      allow read, delete: if signedIn() && userId == me();
      allow create, update: if signedIn() && userId == me() && validUserdata();
    }
  }
}
